IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
# ===== LLM 自动复核（可选）=====
# 方式一（通用，推荐）：填下面三项即可，LLM_PROVIDER 留空。
#   任何 OpenAI 兼容的 /chat/completions 服务都行（DeepSeek、本地 vLLM、Ollama…）
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# 方式二（偷懒）：LLM_PROVIDER=deepseek 或 openai，只填 LLM_API_KEY，端点/模型用默认值
LLM_PROVIDER=
# Qwen3 类推理模型开关：默认 true（关闭思考链，实测提速约 60 倍、输出省约 95%）。
# 若服务端报错不认识该参数，改为 false。
LLM_DISABLE_THINKING=true
